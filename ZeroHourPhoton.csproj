<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Core Photon library: copy Photon-NetStandard.dll into the lib folder next to this file. -->
  <ItemGroup>
    <Reference Include="Photon-NetStandard">
      <HintPath>lib\Photon-NetStandard.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Our program, plus the Photon Realtime source code (copy the PhotonLoadbalancingApi folder next to this file). -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PhotonLoadbalancingApi\**\*.cs" Exclude="PhotonLoadbalancingApi\**\obj\**;PhotonLoadbalancingApi\**\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="20.1.0" />
  </ItemGroup>

  <!-- Steam needs these two files beside the program (put them in this folder). -->
  <ItemGroup>
    <None Include="steam_api64.dll" Condition="Exists('steam_api64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="steam_appid.txt" Condition="Exists('steam_appid.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
